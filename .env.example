# Copy to .env in the repo root (gitignored). Use the SAME password for Docker, API, EF, and tests.
#
# If docorgano-sql already exists, SA_PASSWORD must match the password used when the container
# volume was first created. To reset with a new password: docker compose down -v (destroys SQL data).
SA_PASSWORD=YourStrong!Passw0rd
DB_NAME=DocDb
