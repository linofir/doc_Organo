@page "/Pacientes/Criar"
@using DocFront.Components.Utils
@using DocFront.Models

@inject PacienteState PacienteState
@inject PacienteService PacienteService
@inject NavigationManager Nav

<div class="details-container">
    <h3>Cadastrar Paciente</h3>

    <div class="form-container">
        <EditForm Model="@Paciente" OnValidSubmit="Salvar">
            <DataAnnotationsValidator />

            <ValidationSummary />

            <div class="form-grid">

                <div class="form-group">
                    <label>Nome</label>
                    <InputText class="form-control" @bind-Value="Paciente.Nome" />
                </div>

                <div class="form-group">
                    <label>Nascimento</label>
                    <InputDate class="form-control" @bind-Value="Paciente.Nascimento" />
                </div>

                <div class="form-group">
                    <label>CPF</label>
                    <InputText class="form-control" @bind-Value="Paciente.CPF" />
                </div>

                <div class="form-group">
                    <label>RG</label>
                    <InputText class="form-control" @bind-Value="Paciente.RG" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <InputText class="form-control" @bind-Value="Paciente.Email" />
                </div>

                <div class="form-group">
                    <label>Telefone</label>
                    <InputText class="form-control" @bind-Value="Paciente.Telefone" />
                </div>

                <div class="form-group">
                    <label>Plano de Saúde</label>
                    <InputText class="form-control" @bind-Value="Paciente.Plano" />
                </div>

                <div class="form-group">
                    <label>Carteira</label>
                    <InputText class="form-control" @bind-Value="Paciente.Carteira" />
                </div>
                <div class="form-group">
                    <label>Logradouro</label>
                    <InputText class="form-control" @bind-Value="Paciente.Logradouro" />
                </div>
                <div class="form-group">
                    <label>Número</label>
                    <InputText class="form-control" @bind-Value="Paciente.Numero" />
                </div>
                <div class="form-group">
                    <label>Bairro</label>
                    <InputText class="form-control" @bind-Value="Paciente.Bairro" />
                </div>
                <div class="form-group">
                    <label>Cidade</label>
                    <InputText class="form-control" @bind-Value="Paciente.Cidade" />
                </div>
                <div class="form-group">
                    <label>UF</label>
                    <InputText class="form-control" @bind-Value="Paciente.UF" />
                </div>
                <div class="form-group">
                    <label>Carteira</label>
                    <InputText class="form-control" @bind-Value="Paciente.Carteira" />
                </div>
                <div class="form-group">
                    <label>CEP</label>
                    <InputText class="form-control" @bind-Value="Paciente.CEP" />
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Salvar</button>
            </div>

            @if (!string.IsNullOrEmpty(MensagemSucesso))
            {
                <ActionDiolog
                    Visivel="MostrarDialogAcoes"
                    OnCriarProntuario="IrParaDetalhes"
                    OnCriarOutro="CriarNovoPaciente" />

                <div class="alert alert-success mt-3">@MensagemSucesso</div>
            }

            @if (!string.IsNullOrEmpty(MensagemErro))
            {
                <div class="alert alert-danger mt-3">@MensagemErro</div>
            }
        </EditForm>
    </div>
</div>

