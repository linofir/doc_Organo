    }

    void CriarNovoPaciente()
    {
        MostrarDialogAcoes = false;
        Paciente = new PacienteModel();
    }

    void IrParaDetalhes()
    {
        Nav.NavigateTo($"/Detalhes/{PacienteIdCriado}?tab=prontuarios");
    }

}
