@code {
    private PacienteModel Paciente = new PacienteModel();
    private bool MostrarDialogAcoes = false;
    string? PacienteIdCriado;
    private string? MensagemSucesso;
    private string? MensagemErro;

    private async Task Salvar()
    {
        var result = await PacienteState.CriarAsync(Paciente);

        if (result.Success)
        {
            MensagemSucesso = "Paciente cadastrado com sucesso!";
            await Task.Delay(1500);
            Paciente = new PacienteModel();
            
            PacienteIdCriado = result.Data;
            MostrarDialogAcoes = true;
        }
        else
            MensagemErro = $"Erro ao salvar: {result.Error}";

        @* MensagemSucesso = MensagemErro = null;

        var resultado = await PacienteService.Create(Paciente);

        if (resultado.Success)
