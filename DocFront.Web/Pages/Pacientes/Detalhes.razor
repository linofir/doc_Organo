@page "/Detalhes/{id}"
@using DocFront.Components.Agendamento


@* @inject PacienteService PacienteService *@
@inject PacienteState PacienteState;
@inject ProntuarioState ProntuarioState;
@* @inject ProntuarioService ProntuarioService *@
@inject AgendamentoState AgendamentoState;
@inject AgendamentoService AgendamentoService
@inject NavigationManager Nav

<div class="details-container">
    <h3>Detalhes do Paciente</h3>
    @if (PacienteState.IsLoading)
        {
            <LoadingSpinner/>
        }
        else if (PacienteState.Selecionado is null)
        {
            <p>Paciente não encontrado</p>
        }
        else
        {
            <TabsDetalhes CurrentTab="@CurrentTab" OnTabChange="TrocarAba" />

            <div class="tab-content">
                @if (CurrentTab == "dados")
                {
                    <AbaDados Paciente="PacienteState.Selecionado"  
                        OnSalvar="SalvarPaciente" OnDeletar="DeletarPaciente" />
                }
                else if (CurrentTab == "prontuarios")
                {
                    if(ExibindoProntuarioList)
                    {
                        <ProntuariosList 
                            Resultados="ProntuarioState.Cards"
                            Carregando="ProntuarioState.IsLoadingProntuarios"
                            MenssagemErro="@ProntuarioState.ErrorMessage"
                            OnAbrir="AbrirProntuario"
                            OnNovo="CriarNovoProntuario" />
                    }else
                    {
                        <AbaProntuarios
                            Prontuario="ProntuarioState.Selecionado"
                            Carregando="ProntuarioState.IsLoadingSelecionado"
                            MenssagemErro="@ProntuarioState.ErrorMessage"
                            OnSalvar="SalvarProntuario"
                            OnDeletar="DeletarProntuario" />
                    }
                }
                else if (CurrentTab == "agendamentos")
                {
                    if(ExibindoAgendamentoList)
                    {
                        <AgendamentoList 
                            Resultados="AgendamentoState.Cards"
                            Carregando="AgendamentoState.IsLoadingAgendamentos"
                            MenssagemErro="@AgendamentoState.ErrorMessage"
                            OnAbrir="AbrirAgendamento"
                            OnNovo="CriarNovoAgendamento" />
                    }else
                    {
                        <AbaAgendamentos 
                            Agendamento="AgendamentoState.Selecionado"
                            Carregando="AgendamentoState.IsLoadingSelecionado"
                            MenssagemErro="@AgendamentoState.ErrorMessage"
                            OnSalvar="SalvarAgendamento"
                            OnDeletar="DeletarAgendamento" />
                    }
                }
                else if (CurrentTab == "atendimentos")
                {
                    <AbaAtendimentos PacienteId= "@id" />
                }
            </div>
        }
</div>
@if (!string.IsNullOrEmpty(MensagemSucesso))
{
    <div class="alert alert-success">
        @MensagemSucesso
    </div>
}

@if (!string.IsNullOrEmpty(MensagemErro))
{
    <div class="alert alert-danger">
        @MensagemErro
    </div>
}

