@page "/Detalhes/{id}"
@using DocFront.Components.Agendamento


@inject PacienteService PacienteService
@inject ProntuarioService ProntuarioService
@inject AgendamentoService AgendamentoService
@inject NavigationManager Nav

<div class="details-container">
    <h3>Detalhes do Paciente</h3>
    @if (Carregando)
        {
            <p>Carregando...</p>
        }
        else if (Paciente is null)
        {
            <p>Paciente não encontrado</p>
        }
        else
        {
            <TabsDetalhes CurrentTab="@CurrentTab" OnTabChange="TrocarAba" />

            <div class="tab-content">
                @if (CurrentTab == "dados")
                {
                    <AbaDados Paciente="@Paciente"  OnSalvar="SalvarPaciente" OnDeletar="DeletarPaciente" />
                }
                else if (CurrentTab == "prontuarios")
                {
                    if(ExibindoProntuarioList)
                    {
                        <ProntuariosList 
                            Resultados="Prontuarios"
                            Carregando="CarregandoProntuarios"
                            OnAbrir="AbrirProntuario"
                            OnNovo="CriarNovoProntuario" />
                    }else
                    {
                        <AbaProntuarios
                            Prontuario="ProntuarioSelecionado"
                            Carregando="CarregandoProntuarioSelecionado"
                            OnSalvar="SalvarProntuario"
                            OnDeletar="DeletarProntuario" />
                    }
                }
                else if (CurrentTab == "agendamentos")
                {
                    if(ExibindoAgendamentoList)
                    {
                        <AgendamentoList 
                            Resultados="Agendamentos"
                            Carregando="CarregandoAgendamentos"
                            OnAbrir="AbrirAgendamento"
                            OnNovo="CriarNovoAgendamento" />

                    }else
                    {
                        <AbaAgendamentos 
                            Agendamento="AgendamentoSelecionado"
                            Carregando="CarregandoAgendamentoSelecionado"
                            OnSalvar="SalvarAgendamento"
                            OnDeletar="DeletarAgendamento" />
                    }

                }
                else if (CurrentTab == "atendimentos")
                {
                    <AbaAtendimentos PacienteId= "@id" />
                }
            </div>
        }
</div>
@if (!string.IsNullOrEmpty(MensagemSucesso))
{
    <div class="alert alert-success">
        @MensagemSucesso
    </div>
}

@if (!string.IsNullOrEmpty(MensagemErro))
{
    <div class="alert alert-danger">
        @MensagemErro
    </div>
}

@code {
    [Parameter] public string? id { get; set; }
    PacienteModel? Paciente;
    ProntuarioViewModel? ProntuarioSelecionado;
    string? ProntuarioSelecionadoId;
    List<ProntuarioCardDto> Prontuarios = new();
    bool Carregando = true;
    bool CarregandoProntuarios;
    bool CarregandoProntuarioSelecionado;
    
    List<AgendamentoCardDto> Agendamentos = new();
    AgendamentoViewModel? AgendamentoSelecionado;
    string? AgendamentoSelecionadoId;
    bool CarregandoAgendamentos;
    bool CarregandoAgendamentoSelecionado;

    bool ExibindoProntuarioList = false;
    bool CriandoNovoProntuario;

    bool ExibindoAgendamentoList = false;
    bool CriandoNovoAgendamento;

    bool ExibindoAtendimentoList = false;
    bool CriandoNovoAtendimento;
    string CurrentTab = "dados";
    string? MensagemErro;
    string? MensagemSucesso;

    protected override async Task OnParametersSetAsync()
    {
        Carregando = true;
        var resultado = await PacienteService.GetById(id!);
        Paciente = resultado.Success ? resultado.Data : null;

        Carregando = false;

        // testar Pelo caminho da página  Criar
        @* var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var tab = query["tab"];
        CurrentTab = string.IsNullOrEmpty(tab) ? "dados" : tab; *@
        @* Carregando = false;
        if (CurrentTab == "prontuarios")
            await BuscarProntuarios(); *@
    }
    void TrocarAba(string tab)
    {
        if (CurrentTab == tab)
        return;

        CurrentTab = tab;

        if (tab == "prontuarios")
        {
            ExibindoProntuarioList = true;
            _ = BuscarProntuarios();
        }
        if (tab == "agendamentos")
        {
            ExibindoAgendamentoList = true;
            Console.WriteLine("Buscar Agendamwntos teste");
            _ = BuscarAgendamentos();
        }

        Nav.NavigateTo($"/Detalhes/{id}?tab={tab}", replace: true);
    }
    async Task SalvarPaciente(PacienteModel pacienteEditado)
    {
        MensagemErro = null;
        MensagemSucesso = null;

        var resultado = await PacienteService.Update(pacienteEditado.ID, pacienteEditado);

        if (resultado.Success)
        {
            // 🔑 Atualiza a fonte da verdade
            Paciente = pacienteEditado;

            MensagemSucesso = "Paciente atualizado com sucesso";
        }
        else
        {
            MensagemErro = resultado.Error!;
        }
    }
    async Task DeletarPaciente(PacienteModel pacienteEditado)
    {
        MensagemErro = null;
        MensagemSucesso = null;

        var resultado = await PacienteService.Delete(pacienteEditado.ID);

        if (resultado.Success)
        {

            MensagemSucesso = "Paciente deletado com sucesso";
            await Task.Delay(1000);
            Nav.NavigateTo("/Pacientes/Gerenciar");
        }
        else
        {
            MensagemErro = resultado.Error!;
        }
    }

    ////////////////////////////////////////Prontuários////////////////////////
    async Task BuscarProntuarios()
    {
        if(CarregandoProntuarios)
            return;
        CarregandoProntuarios = true;

        var  result = await ProntuarioService.GetByPaciente(id!);
        Prontuarios = result.Success && result.Data != null
            ? result.Data.ToList()
            : new List<ProntuarioCardDto>();


        CarregandoProntuarios = false;
        await InvokeAsync(StateHasChanged);
    }
    async Task AbrirProntuario(string prontuarioId)
    {
        ExibindoProntuarioList = false;
        CriandoNovoProntuario = false;
        if(CarregandoProntuarioSelecionado)
            return;
        CarregandoProntuarioSelecionado = true;
        ProntuarioSelecionadoId = prontuarioId;

        var result = await ProntuarioService.GetById(prontuarioId);

        if (result.Success)
            ProntuarioSelecionado = result.Data;

        CarregandoProntuarioSelecionado = false;
        await InvokeAsync(StateHasChanged);
    }
    async Task CriarNovoProntuario()
    {
        ExibindoProntuarioList = false;
        CriandoNovoProntuario = true;
        ProntuarioSelecionado = null;
        await InvokeAsync(StateHasChanged);
        ProntuarioSelecionado = new ProntuarioViewModel
        {
            DescricaoBasica = new DescricaoBasicaViewModel()
            {
                PacienteId = Paciente?.ID,
                NomePaciente = Paciente?.Nome,
                Cpf = Paciente?.CPF,
                Idade = Paciente!.Idade
            },
            AGO = new AGOViewModel(),
            Antecedentes = new AntecedentesViewModel(),
            AntecedentesFamiliares = new AntecedentesFamiliaresViewModel(),
            SolicitacaoInternacao = new InternacaoViewModel(),
            Exames = new List<ExameViewModel>(),
            PosOperatorio = new PosOpViewModel()

        };

    }
    async Task SalvarProntuario(ProntuarioViewModel prontuarioEditado)
    {
        MensagemErro = null;
        MensagemSucesso = null;
        ApiResponse<bool> resultado;
        if (CriandoNovoProntuario)
        {
            // 👉 NOVO
            resultado = await ProntuarioService.Create(prontuarioEditado);
        }
        else
        {
            // 👉 EDITAR
            resultado = await ProntuarioService.Update(prontuarioEditado.Id, prontuarioEditado);
        }

        if (resultado.Success)
        {
            // 🔑 Atualiza a fonte da verdade
            ProntuarioSelecionado = prontuarioEditado;
            MensagemSucesso = "Prontuario atualizado com sucesso";
        }
        else
        {
            MensagemErro = resultado.Error!;
        }
    }
    async Task DeletarProntuario(ProntuarioViewModel prontuarioEditado)
    {
        MensagemErro = null;
        MensagemSucesso = null;
        if (string.IsNullOrEmpty(prontuarioEditado.Id))
        {
            MensagemErro = "Prontuário inválido para exclusão.";
            return;
        }

        var resultado = await ProntuarioService.Delete(prontuarioEditado.Id);

        if (resultado.Success)
        {

            MensagemSucesso = "Prontuario deletado com sucesso";
            await Task.Delay(1000);
            Nav.NavigateTo($"/Detalhes/{id}"); 
        } 
        else
        {
            MensagemErro = resultado.Error!;
        }
    }

    ////////////////////////////////////////Agendamentos////////////////////////
    async Task BuscarAgendamentos()
    {
        if(CarregandoAgendamentos)
            return;
        CarregandoAgendamentos = true;

        var  result = await AgendamentoService.GetByPaciente(id!);
        Agendamentos = result.Success && result.Data != null
            ? result.Data.ToList()
            : new List<AgendamentoCardDto>();


        CarregandoAgendamentos = false;
        await InvokeAsync(StateHasChanged);
    }
    async Task AbrirAgendamento(string agendamentoId)
    {
        ExibindoAgendamentoList = false;
        CriandoNovoAgendamento = false;
        if(CarregandoProntuarioSelecionado)
            return;
        CarregandoProntuarioSelecionado = true;
        AgendamentoSelecionadoId = agendamentoId;

        var result = await AgendamentoService.GetById(agendamentoId);

        if (result.Success)
            AgendamentoSelecionado = result.Data;
        
        CarregandoProntuarioSelecionado = false;
        await InvokeAsync(StateHasChanged);
    }
    async Task CriarNovoAgendamento()
    {
        ExibindoAgendamentoList = false;
        CriandoNovoAgendamento = true;
        AgendamentoSelecionado = null;
        await InvokeAsync(StateHasChanged);

        AgendamentoSelecionado = new AgendamentoViewModel
        {
           PacienteID = Paciente.ID,
            Nome = Paciente.Nome,
            Aviso = "",
            Data = DateOnly.MinValue,  
            Horario = TimeOnly.MinValue,
            Procedimento = "",
            Local = "",
            Sala = "",
            SenhaAgendamento = new SenhaViewModel(),
            @* Status = new StatusViewModel(),     *@
            StatusInstrucoes = "",
            StatusAtestado = "",
            DataConsulta = DateOnly.MinValue,
        };
        
    }
    async Task SalvarAgendamento(AgendamentoViewModel agendamentoEditado)
    {
        MensagemErro = null;
        MensagemSucesso = null;
        ApiResponse<bool> resultado;
        if (CriandoNovoAgendamento)
        {
            // 👉 NOVO
            resultado = await AgendamentoService.Create(agendamentoEditado);
        }
        else
        {
            // 👉 EDITAR
            resultado = await AgendamentoService.Update(agendamentoEditado.ID, agendamentoEditado);
        }

        if (resultado.Success)
        {
            // 🔑 Atualiza a fonte da verdade
            AgendamentoSelecionado = agendamentoEditado;
            MensagemSucesso = "Agendamento atualizado com sucesso";
        }
        else
        {
            MensagemErro = resultado.Error!;
        }
    }
    async Task DeletarAgendamento(AgendamentoViewModel agendamentoEditado)
    {
        MensagemErro = null;
        MensagemSucesso = null;
        if (string.IsNullOrEmpty(agendamentoEditado.ID))
        {
            MensagemErro = "Agendamento inválido para exclusão.";
            return;
        }

        var resultado = await AgendamentoService.Delete(agendamentoEditado.ID);

        if (resultado.Success)
        {
          
            MensagemSucesso = "Agendamento deletado com sucesso";
            await Task.Delay(1000);
            Nav.NavigateTo($"/Detalhes/{id}"); 
        } 
        else
        {
            MensagemErro = resultado.Error!;
        }
    }

}