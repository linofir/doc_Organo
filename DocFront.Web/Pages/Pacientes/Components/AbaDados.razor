@using DocFront.Models

<EditForm Model="@Paciente">
    <DataAnnotationsValidator />

    <div class="card-detalhe">

        <div class="form-grid">

            <div class="form-group">
                <label>Nome</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente!.Nome"
                           disabled="@(!IsEditing)" />
            </div>

            <div class="form-group">
                <label>Nascimento</label>
                <InputDate class="form-control"
                           @bind-Value="NascimentoDate"
                           disabled="@(!IsEditing)" />
            </div>

            <div class="form-group">
                <label>CPF</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.CPF"
                           disabled="@(!IsEditing)" />
            </div>

            <div class="form-group">
                <label>RG</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.RG"
                           disabled="@(!IsEditing)" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Email"
                           disabled="@(!IsEditing)" />
            </div>

            <div class="form-group">
                <label>Telefone</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Telefone"
                           disabled="@(!IsEditing)" />
            </div>

            <div class="form-group">
                <label>Plano de Saúde</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Plano"
                           disabled="@(!IsEditing)" />
            </div>

            <div class="form-group">
                <label>Carteira</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Carteira"
                           disabled="@(!IsEditing)" />
            </div>
            <div class="form-group">
                <label>Logradouro</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Logradouro"
                           disabled="@(!IsEditing)" />
            </div>
            <div class="form-group">
                <label>Número</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Numero"
                           disabled="@(!IsEditing)" />
            </div>
            <div class="form-group">
                <label>Bairro</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Bairro"
                           disabled="@(!IsEditing)" />
            </div>
            <div class="form-group">
                <label>Cidade</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.Cidade"
                           disabled="@(!IsEditing)" />
            </div>
            <div class="form-group">
                <label>UF</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.UF"
                           disabled="@(!IsEditing)" />
            </div>
            <div class="form-group">
                <label>CEP</label>
                <InputText class="form-control"
                           @bind-Value="EditPaciente.CEP"
                           disabled="@(!IsEditing)" />
            </div>

        </div>

        <div class="form-actions">
            @if (!IsEditing)
            {
                <button type="button" class="btn-edit" @onclick="Editar">
                    Editar
                </button>
                <button type="button"
                        class="btn-delete"
                        @onclick=" () => MostrarConfirmacao = true">
                    Deletar
                </button>

                <ConfirmDialog
                    Visivel="MostrarConfirmacao"
                    Titulo="Cuidado!"
                    Mensagem="Ao deletar, todos os dados do paciente serão apagados. Deseja continuar?"
                    OnClose="OnConfirmDelete" />

            }
            else
            {
                <button type="button"
                        class="btn-save"
                        @onclick="SalvarClick">
                    Salvar
                </button>

                <button type="button" class="btn-delete" @onclick="Cancelar">
                    Cancelar
                </button>
            }
        </div>

    </div>
</EditForm> 

@code {
    [Parameter, EditorRequired]
    public PacienteModel Paciente { get; set; } = default!;
    PacienteModel EditPaciente = new();

    [Parameter]
    public EventCallback<PacienteModel> OnSalvar { get; set; }
    [Parameter]
    public EventCallback<PacienteModel> OnDeletar { get; set; }
    @* [Parameter] 
    public EventCallback<bool> OnClose { get; set; } *@
    bool IsEditing = false;
    bool MostrarConfirmacao = false;


    protected override void OnParametersSet()
{
    // Inicializa o model de edição com os dados vindos do pai
    EditPaciente = new PacienteModel
    {
        ID = Paciente.ID,
        Nome = Paciente.Nome,
        CPF = Paciente.CPF,
        RG = Paciente.RG,
        Email = Paciente.Email,
        Telefone = Paciente.Telefone,
        Plano = Paciente.Plano,
        Carteira = Paciente.Carteira,
        Nascimento = Paciente.Nascimento,
        Logradouro = Paciente.Logradouro,
        Numero = Paciente.Numero,
        Bairro = Paciente.Bairro,
        Cidade = Paciente.Cidade,
        UF = Paciente.UF,
        CEP = Paciente.CEP
    };
}
    // 🔹 Ponte entre DateOnly e InputDate
    DateTime NascimentoDate
    {
        get => EditPaciente.Nascimento.ToDateTime(TimeOnly.MinValue);
        set => EditPaciente.Nascimento = DateOnly.FromDateTime(value);
    }
    async Task SalvarClick()
    {
        await OnSalvar.InvokeAsync(EditPaciente);
        IsEditing = false;
    }
    async Task OnConfirmDelete(bool confirmado)
    {
        MostrarConfirmacao = false;

        if (!confirmado)
            return;

        await OnDeletar.InvokeAsync(EditPaciente);
    }


    async Task DeletarClick()
    {
        await OnDeletar.InvokeAsync(EditPaciente);
    }
    void Editar()
    {
        IsEditing = true;
    }

    void Cancelar()
    {
        EditPaciente = new PacienteModel
        {
            ID = Paciente.ID,
            Nome = Paciente.Nome,
            CPF = Paciente.CPF,
            RG = Paciente.RG,
            Email = Paciente.Email,
            Telefone = Paciente.Telefone,
            Plano = Paciente.Plano,
            Carteira = Paciente.Carteira,
            Nascimento = Paciente.Nascimento,
            Logradouro = Paciente.Logradouro,
            Numero = Paciente.Numero,
            Bairro = Paciente.Bairro,
            Cidade = Paciente.Cidade,
            UF = Paciente.UF,
            CEP = Paciente.CEP
        };
        IsEditing = false;
        // TODO: recarregar dados do backend
    }
}
