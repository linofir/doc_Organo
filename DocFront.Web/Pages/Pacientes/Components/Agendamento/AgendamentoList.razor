@namespace DocFront.Components.Agendamento

@inject AgendamentoService AgendamentoService
@inject NavigationManager Nav

<div class="exhibition-box mt-3">
    <button class="btn btn-primary"
            @onclick="CriarNovoAgendamnto">
        + Novo Agendamento
    </button>
    @if (Carregando)
    {
        <LoadingSpinner/>
    }
    else if (!string.IsNullOrEmpty(MenssagemErro))
    {
        <p class="text-danger">@MenssagemErro</p>
    }
    else if (!Resultados.Any())
    {
        <p>Nenhum prontuário encontrado.</p>
    }
    else
    {
        <div class="exhibition-box mt-3">
            @foreach (AgendamentoCardDto agendamento in Resultados)
            {
                <AgendamentoCard Agendamento="agendamento"
                            OnAbrir="AbrirAgendamento" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<AgendamentoCardDto> Resultados { get; set; } = new();
    [Parameter]
    public bool Carregando { get; set; } 
    [Parameter]
    public string? MenssagemErro { get; set; }
    [Parameter]
    public EventCallback OnNovo { get; set; }
    [Parameter] 
    public EventCallback<string> OnAbrir { get; set; }
    Task AbrirAgendamento (string id)
        => OnAbrir.InvokeAsync(id);
    async Task CriarNovoAgendamnto()
    {
        @* Console.WriteLine("BOTÃO CLICADO"); *@
        if (OnNovo.HasDelegate)
            await OnNovo.InvokeAsync();
    }

   }