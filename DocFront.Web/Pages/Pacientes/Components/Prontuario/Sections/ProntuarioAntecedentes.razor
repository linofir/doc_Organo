@namespace DocFront.Components.Prontuario.Sections

@using DocFront.Models.ViewModels



<div class="section">
    <h3>Antecedentes</h3>

    <div class="form-grid">
        <div class="form-group">
            <label>Comorbidades</label>
            <InputTextArea class="form-control" @bind-Value="Antecedentes.Comorbidades" disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Medicacao</label>
            <InputTextArea class="form-control" @bind-Value="Antecedentes.Medicacao" disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Neoplasias</label>
            <InputTextArea class="form-control" @bind-Value="Antecedentes.Neoplasias" disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Cirurgias</label>
            <InputTextArea class="form-control" @bind-Value="Antecedentes.Cirurgias" disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Alergias</label>
            <InputTextArea class="form-control" @bind-Value="Antecedentes.Alergias" disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Vicios</label>
            <InputText class="form-control" @bind-Value="Antecedentes.Vicios" disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Habito Intestinal</label>
            <InputText class="form-control" @bind-Value="Antecedentes.HabitoIntestinal" disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Vacinas</label>
            </div><InputText class="form-control" @bind-Value="Antecedentes.Vacinas" disabled="@(!IsEditing)" />

    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AntecedentesViewModel Antecedentes { get; set; } = default!;

    [Parameter]
    public bool IsEditing { get; set; }
}
