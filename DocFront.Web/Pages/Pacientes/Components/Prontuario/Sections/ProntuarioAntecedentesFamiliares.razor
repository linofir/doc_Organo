@namespace DocFront.Components.Prontuario.Sections

@using DocFront.Models.ViewModels


<div class="section">
    <h3>Antecedentes Familiares</h3>

    <div class="form-grid">
        <div class="form-group">
            <label>Neoplasias</label>
            <InputTextArea class="form-control"
                       @bind-Value="AntecedentesFamiliares.Neoplasias"
                       disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Comorbidades</label>
            <InputTextArea class="form-control"
                        @bind-Value="AntecedentesFamiliares.Comorbidades"
                        disabled="@(!IsEditing)" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AntecedentesFamiliaresViewModel AntecedentesFamiliares { get; set; } = default!;

    [Parameter]
    public bool IsEditing { get; set; }
}
