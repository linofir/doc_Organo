@namespace DocFront.Components.Prontuario.Sections

@using DocFront.Models.ViewModels



<div class="section">
    <h3>Descrição Básica</h3>

    <div class="form-grid">
        <div class="form-group">
            <label>Nome da Paciente</label>
            <InputText class="form-control" @bind-Value="Descricao.NomePaciente" disabled />
        </div>
        <div class="form-group">
            <label>CPF</label>
        <InputText class="form-control" @bind-Value="Descricao.Cpf" disabled />
        </div>
        <div class="form-group">
            <label>Idade</label>
        <InputNumber class="form-control" @bind-Value="Descricao.Idade" disabled />
        </div>
        <div class="form-group">
            <label>Profissao</label>
            <InputText class="form-control"
                   @bind-Value="Descricao.Profissao"
                   disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Religião</label>
            <InputText class="form-control"
                   @bind-Value="Descricao.Religiao"
                   disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>QD</label>
            <InputTextArea class="form-control"
                       @bind-Value="Descricao.QD"
                       disabled="@(!IsEditing)" />
        </div>
        <div class="form-group">
            <label>Atividade Física</label>
            <InputText class="form-control"
                   @bind-Value="Descricao.AtividadeFisica"
                   disabled="@(!IsEditing)" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DescricaoBasicaViewModel Descricao { get; set; } = default!;

    [Parameter]
    public bool IsEditing { get; set; }
}
