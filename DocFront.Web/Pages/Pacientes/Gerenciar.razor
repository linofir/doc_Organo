@page "/Pacientes/Gerenciar"

@inject PacienteState PacienteState
@inject NavigationManager Nav

<h3 class="mb-4">Gerenciar Pacientes</h3>

<div class="mb-3">
    <label for="busca">Buscar por Nome ou CPF</label>
    <input class="form-control"
       @bind="Busca"
       placeholder="Digite nome ou CPF...ou clique em buscar" />
    @* <input id="busca" class="form-control" placeholder="Digite algo...ou clique em buscar " /> *@
</div>

@* <BtnAction Texto="Buscar" OnClick="@(() => BuscarTodosPacientes())" /> *@
<BtnAction Texto="Buscar" OnClick="Buscar" />

<hr />

<h5>Resultados da busca</h5>

<div class="exhibition-box mt-3">
    @if (PacienteState.IsLoading)
    {
        <LoadingSpinner />
        @* <p>Carregando...</p> *@
    }
    else if (!PacienteState.Cards.Any())
    {
        <p>Nenhum paciente encontrado.</p>
    }
    else
    {
        <div class="exhibition-box mt-3">
            @foreach (var paciente in PacienteState.Cards)
            {
                <PacienteCard Paciente="paciente"
                            OnAbrir="AbrirPaciente" />
            }
        </div>
    }
</div> 

@code{
    @inject NavigationManager Nav
    @* string pacienteId = "123IDTEst"; *@
    @* private PacienteModel Paciente = new PacienteModel(); *@
    @* private string? MensagemSucesso; *@
    @* private string? MensagemErro; *@
    @* bool Carregando;
    List<PacienteListDto> Resultados = new(); *@

    @* protected override async Task OnInitializedAsync()
    {
        await PacienteState.LoadAllAsync();
    }  *@
    private string? Busca;

    async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(Busca))
            await PacienteState.BuscarTodosAsync();
        else if (Busca.All(char.IsDigit))
            await PacienteState.BuscarPorCpfAsync(Busca);
        else
            await PacienteState.BuscarPorNomeAsync(Busca);
    }
    @* async Task BuscarTodosPacientes()
    {
        await PacienteState.LoadAllAsync(force: true);
        Carregando = true;

        var result = await PacienteService.GetAll();

        if (result.Success)
            Resultados = result.Data!;
        else
            Resultados.Clear();

        Carregando = false;
    } *@

    void AbrirPaciente(string id)
    {
        Nav.NavigateTo($"/Detalhes/{id}"); 

    }

}

