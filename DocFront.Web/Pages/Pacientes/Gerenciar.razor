    @* private string? MensagemSucesso; *@
    @* private string? MensagemErro; *@
    bool Carregando;
    List<PacienteListDto> Resultados = new();

    async Task BuscarTodosPacientes()
    {
        Carregando = true;

        var result = await PacienteService.GetAll();

        if (result.Success)
            Resultados = result.Data!;
        else
            Resultados.Clear();

        Carregando = false;
    }

